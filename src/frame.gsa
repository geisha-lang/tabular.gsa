// In-memory typed columnar DataFrame (`tabular.frame`).

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.buf.{bufNew, bufPushStr, bufToString}
use std.str.{intToStr, i64ToStr, floatToStr, boolToStr}
use std.list.{listLen, listAppend}
use duckdb.duckdb.{
    Connection, QueryResult,
    ColBool, ColInt64, ColFloat, ColString,
    openMemory, closeDb, connect, disconnect,
    query, readParquet, readCsv, closeResult,
    resRowCount, resColCount, resColName, resColKind,
    resGetBool, resColToFloatArray, resColToInt64Array, resColToStrArray
}
use tabular.series.{Series, MkSeries, isNan}

pub data Column {
    ColF64(String, MutArray Float),
    ColI64(String, MutArray Int64),
    ColStr(String, MutArray String),
    ColFlag(String, MutArray Bool),
}

pub data DataFrame {
    MkDataFrame {
        numRows: Int,
        cols: List Column,
    },
}

pub def colName(c: Column): String = match c {
    ColF64(n, _) -> n,
    ColI64(n, _) -> n,
    ColStr(n, _) -> n,
    ColFlag(n, _) -> n,
}

pub def colTypeName(c: Column): String = match c {
    ColF64(_, _) -> "Float",
    ColI64(_, _) -> "Int64",
    ColStr(_, _) -> "String",
    ColFlag(_, _) -> "Bool",
}

pub def dfHeight(df: DataFrame): Int = df.numRows
pub def dfWidth(df: DataFrame): Int = listLen(df.cols)

def mapColNamesRec(cols: List Column): List String = match cols {
    Nil -> Nil,
    Cons(c, rest) -> Cons(colName(c), mapColNamesRec(rest)),
}

pub def dfColNames(df: DataFrame): List String = mapColNamesRec(df.cols)

def resColToBoolArray(res: QueryResult, col: Int): MutArray Bool = {
    let n = i64ToInt(resRowCount(res));
    let arr = arrayNew(n, false);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        arraySet(arr, idx, resGetBool(res, col, intToI64(idx)));
        cellSet(i, idx + 1)
    };
    arr
}

def buildColsRec(res: QueryResult, idx: Int, total: Int): List Column =
    if (idx >= total) Nil
    else {
        let nm = resColName(res, idx);
        let col = match resColKind(res, idx) {
            ColFloat -> ColF64(nm, resColToFloatArray(res, idx)),
            ColInt64 -> ColI64(nm, resColToInt64Array(res, idx)),
            ColBool -> ColFlag(nm, resColToBoolArray(res, idx)),
            ColString -> ColStr(nm, resColToStrArray(res, idx)),
        };
        Cons(col, buildColsRec(res, idx + 1, total))
    }

pub def dfFromResult(res: QueryResult): DataFrame =
    MkDataFrame {
        numRows: i64ToInt(resRowCount(res)),
        cols: buildColsRec(res, 0, resColCount(res)),
    }

// Zero-boilerplate direct file readers (auto-managed ephemeral DuckDB engine).
pub def dfReadParquet(path: String): Result DataFrame String = {
    let db = openMemory()?;
    let conn = connect(db)?;
    let res = readParquet(conn, path);
    match res {
        Err(e) -> { disconnect(conn); closeDb(db); Err(e) },
        Ok(r) -> {
            let df = dfFromResult(r);
            closeResult(r);
            disconnect(conn);
            closeDb(db);
            Ok(df)
        },
    }
}

pub def dfReadCsv(path: String): Result DataFrame String = {
    let db = openMemory()?;
    let conn = connect(db)?;
    let res = readCsv(conn, path);
    match res {
        Err(e) -> { disconnect(conn); closeDb(db); Err(e) },
        Ok(r) -> {
            let df = dfFromResult(r);
            closeResult(r);
            disconnect(conn);
            closeDb(db);
            Ok(df)
        },
    }
}

def findCol(cols: List Column, target: String): Option Column = match cols {
    Nil -> None,
    Cons(c, rest) ->
        if (colName(c) == target) Some(c)
        else findCol(rest, target),
}

def listHasStr(xs: List String, target: String): Bool = match xs {
    Nil -> false,
    Cons(h, t) -> if (h == target) true else listHasStr(t, target),
}

def selectColsRec(allCols: List Column, names: List String): Result (List Column) String = match names {
    Nil -> Ok(Nil),
    Cons(nm, rest) -> match findCol(allCols, nm) {
        None -> Err("column not found: " + nm),
        Some(c) -> {
            let tail = selectColsRec(allCols, rest)?;
            Ok(Cons(c, tail))
        },
    },
}

pub def dfSelect(df: DataFrame, names: List String): Result DataFrame String = {
    let selected = selectColsRec(df.cols, names)?;
    Ok(MkDataFrame { numRows: df.numRows, cols: selected })
}

def dropColsRec(cols: List Column, names: List String): List Column = match cols {
    Nil -> Nil,
    Cons(c, rest) ->
        if (listHasStr(names, colName(c))) dropColsRec(rest, names)
        else Cons(c, dropColsRec(rest, names)),
}

pub def dfDrop(df: DataFrame, names: List String): DataFrame =
    MkDataFrame { numRows: df.numRows, cols: dropColsRec(df.cols, names) }

def replaceOrAppendCol(cols: List Column, newCol: Column): List Column = match cols {
    Nil -> [newCol],
    Cons(c, rest) ->
        if (colName(c) == colName(newCol)) Cons(newCol, rest)
        else Cons(c, replaceOrAppendCol(rest, newCol)),
}

pub def dfWithColumn(df: DataFrame, col: Column): DataFrame =
    MkDataFrame { numRows: df.numRows, cols: replaceOrAppendCol(df.cols, col) }

def sliceColumn(c: Column, start: Int, len: Int): Column = match c {
    ColF64(nm, arr) -> {
        let out = arrayNew(len, 0.0);
        let i = cellNew(0);
        while (cellGet(i) < len) {
            let k = cellGet(i);
            arraySet(out, k, arrayGet(arr, start + k));
            cellSet(i, k + 1)
        };
        ColF64(nm, out)
    },
    ColI64(nm, arr) -> {
        let out = arrayNew(len, intToI64(0));
        let i = cellNew(0);
        while (cellGet(i) < len) {
            let k = cellGet(i);
            arraySet(out, k, arrayGet(arr, start + k));
            cellSet(i, k + 1)
        };
        ColI64(nm, out)
    },
    ColStr(nm, arr) -> {
        let out = arrayNew(len, "");
        let i = cellNew(0);
        while (cellGet(i) < len) {
            let k = cellGet(i);
            arraySet(out, k, arrayGet(arr, start + k));
            cellSet(i, k + 1)
        };
        ColStr(nm, out)
    },
    ColFlag(nm, arr) -> {
        let out = arrayNew(len, false);
        let i = cellNew(0);
        while (cellGet(i) < len) {
            let k = cellGet(i);
            arraySet(out, k, arrayGet(arr, start + k));
            cellSet(i, k + 1)
        };
        ColFlag(nm, out)
    },
}

def sliceColsRec(cols: List Column, start: Int, len: Int): List Column = match cols {
    Nil -> Nil,
    Cons(c, rest) -> Cons(sliceColumn(c, start, len), sliceColsRec(rest, start, len)),
}

pub def dfSlice(df: DataFrame, offset: Int, len: Int): DataFrame = {
    let s = if (offset < 0) 0 else if (offset > df.numRows) df.numRows else offset;
    let avail = df.numRows - s;
    let n = if (len < 0) 0 else if (len > avail) avail else len;
    MkDataFrame { numRows: n, cols: sliceColsRec(df.cols, s, n) }
}

pub def dfHead(df: DataFrame, n: Int): DataFrame = dfSlice(df, 0, n)

pub def dfSeries(df: DataFrame, name: String): Result Series String = match findCol(df.cols, name) {
    Some(ColF64(_, arr)) -> Ok(MkSeries { len: df.numRows, values: arr }),
    Some(ColI64(_, arr)) -> {
        let out = arrayNew(df.numRows, 0.0);
        let i = cellNew(0);
        while (cellGet(i) < df.numRows) {
            let idx = cellGet(i);
            arraySet(out, idx, intToFloat(i64ToInt(arrayGet(arr, idx))));
            cellSet(i, idx + 1)
        };
        Ok(MkSeries { len: df.numRows, values: out })
    },
    Some(_) -> Err("column '" + name + "' is not numeric"),
    None -> Err("column not found: " + name),
}

pub def dfColInt64(df: DataFrame, name: String): Result (MutArray Int64) String = match findCol(df.cols, name) {
    Some(ColI64(_, arr)) -> Ok(arr),
    Some(_) -> Err("column '" + name + "' is not Int64"),
    None -> Err("column not found: " + name),
}

pub def dfColStr(df: DataFrame, name: String): Result (MutArray String) String = match findCol(df.cols, name) {
    Some(ColStr(_, arr)) -> Ok(arr),
    Some(_) -> Err("column '" + name + "' is not String"),
    None -> Err("column not found: " + name),
}

pub def dfColBool(df: DataFrame, name: String): Result (MutArray Bool) String = match findCol(df.cols, name) {
    Some(ColFlag(_, arr)) -> Ok(arr),
    Some(_) -> Err("column '" + name + "' is not Bool"),
    None -> Err("column not found: " + name),
}

def cellToStr(c: Column, row: Int): String = match c {
    ColF64(_, arr) -> {
        let v = arrayGet(arr, row);
        if (isNan(v)) "null" else floatToStr(v)
    },
    ColI64(_, arr) -> i64ToStr(arrayGet(arr, row)),
    ColStr(_, arr) -> arrayGet(arr, row),
    ColFlag(_, arr) -> boolToStr(arrayGet(arr, row)),
}

def pushRowCells(out: std.buf.StringBuf, cols: List Column, row: Int, first: Bool): Void = match cols {
    Nil -> (),
    Cons(c, rest) -> {
        if (!first) bufPushStr(out, " | ") else ();
        bufPushStr(out, cellToStr(c, row));
        pushRowCells(out, rest, row, false)
    },
}

def pushHeaderNames(out: std.buf.StringBuf, cols: List Column, first: Bool): Void = match cols {
    Nil -> (),
    Cons(c, rest) -> {
        if (!first) bufPushStr(out, " | ") else ();
        bufPushStr(out, colName(c) + ":" + colTypeName(c));
        pushHeaderNames(out, rest, false)
    },
}

pub def dfFormat(df: DataFrame, maxRows: Int): String = {
    let out = bufNew();
    bufPushStr(out, "shape: (" + intToStr(df.numRows) + ", " + intToStr(dfWidth(df)) + ")\n");
    pushHeaderNames(out, df.cols, true);
    bufPushStr(out, "\n");
    let lim = if (maxRows < df.numRows) maxRows else df.numRows;
    let r = cellNew(0);
    while (cellGet(r) < lim) {
        pushRowCells(out, df.cols, cellGet(r), true);
        bufPushStr(out, "\n");
        cellSet(r, cellGet(r) + 1)
    };
    bufToString(out)
}
