// Clean, prefix-free Polars-style expression builders (`tabular.expr`) backed by `duckdb.dsl`.

use duckdb.dsl.{
    Expr, OrderItem,
    col, qcol, litInt, litInt64, litFloat, litStr, litBool, litNull, rawExpr,
    eq, neq, lt, lte, gt, gte,
    and_, or_, not_, isNull, isNotNull, like, between, inStrs, inInt64s,
    add, sub, mul, div, neg,
    asCol, fnCall, sum, avg, min_, max_, stddev, median, countAll, countCol, countDistinct,
    coalesce, castFloat, castInt64, castStr, overPartition, asc, desc
}

pub def (|>)(x: a, f: a -> b): b = f(x)

pub def alias(e: Expr, name: String): Expr = asCol(e, name)
pub def mean(e: Expr): Expr = avg(e)
pub def std(e: Expr): Expr = stddev(e)
pub def count(e: Expr): Expr = countCol(e)
pub def over(e: Expr, partitionCols: List String, orders: List OrderItem): Expr =
    overPartition(e, partitionCols, orders)

pub def col_(name: String): Expr = col(name)
pub def star(): Expr = rawExpr("*")
