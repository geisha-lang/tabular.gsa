// Verification suite for `tabular.gsa` (`tests/spec.gsa`).

use std.result.{Result, Ok, Err}
use sys.fs.removeFile
use sys.io.eprintLn
use sys.proc.exit

use duckdb.duckdb.{openMemory, closeDb, connect, disconnect, exec, writeParquet}
use duckdb.dsl.{col, litFloat, mul, gt, sum, countAll}
use tabular.expr.{alias, mean}
use tabular.series.{
    nanVal, isNan, seriesNew, seriesSet, seriesGet,
    seriesMean, seriesStd, seriesMedian, seriesRank, seriesZscore,
    seriesCorr, seriesRankCorr, seriesRollingMean, seriesEma
}
use tabular.frame.{dfHeight, dfWidth, dfDrop, dfSeries, dfColStr, dfFormat}
use tabular.lazy.{scanParquet, collect, sinkParquet}
use tabular.tabular.{
    (|>),
    selectCols, withColumns, filter, dropNulls, groupByAgg,
    sortAsc, sortDesc, limit, head, readParquet
}

def assertTrue(label: String, ok: Bool): Result Void String =
    if (ok) Ok(()) else Err("ASSERT FAILED: " + label)

def approxEq(a: Float, b: Float, eps: Float): Bool = {
    let d = a - b;
    (if (d < 0.0) 0.0 - d else d) <= eps
}

def testSeriesStats(): Result Void String = {
    let s = seriesNew(5, nanVal());
    seriesSet(s, 0, 10.0);
    seriesSet(s, 1, 20.0);
    seriesSet(s, 2, nanVal());
    seriesSet(s, 3, 20.0);
    seriesSet(s, 4, 30.0);

    assertTrue("seriesMean ignores NaN", approxEq(seriesMean(s), 20.0, 1.0e-9))?;
    assertTrue("seriesMedian == 20.0", approxEq(seriesMedian(s), 20.0, 1.0e-9))?;
    assertTrue("seriesStd(ddof=1)", approxEq(seriesStd(s, true), 8.16496580927726, 1.0e-6))?;

    let r = seriesRank(s);
    assertTrue("rank[0] == 0.25", approxEq(seriesGet(r, 0), 0.25, 1.0e-9))?;
    assertTrue("rank[1] == 0.625 (tie avg)", approxEq(seriesGet(r, 1), 0.625, 1.0e-9))?;
    assertTrue("rank[2] stays NaN", isNan(seriesGet(r, 2)))?;
    assertTrue("rank[4] == 1.0", approxEq(seriesGet(r, 4), 1.0, 1.0e-9))?;

    let z = seriesZscore(s);
    assertTrue("zscore mean == 0", approxEq(seriesMean(z), 0.0, 1.0e-9))?;

    let a = seriesNew(4, 0.0);
    let b = seriesNew(4, 0.0);
    seriesSet(a, 0, 1.0); seriesSet(a, 1, 2.0); seriesSet(a, 2, 3.0); seriesSet(a, 3, 4.0);
    seriesSet(b, 0, 1.0); seriesSet(b, 1, 4.0); seriesSet(b, 2, 9.0); seriesSet(b, 3, 16.0);
    assertTrue("Spearman rank corr == 1.0", approxEq(seriesRankCorr(a, b), 1.0, 1.0e-9))?;
    assertTrue("Pearson corr > 0.98", seriesCorr(a, b) > 0.98)?;

    let rm = seriesRollingMean(a, 2, 2);
    assertTrue("rollingMean[0] is NaN", isNan(seriesGet(rm, 0)))?;
    assertTrue("rollingMean[3] == 3.5", approxEq(seriesGet(rm, 3), 3.5, 1.0e-9))?;

    let em = seriesEma(a, 3.0);
    assertTrue("ema[0] == 1.0", approxEq(seriesGet(em, 0), 1.0, 1.0e-9))?;
    assertTrue("ema[1] == 1.5", approxEq(seriesGet(em, 1), 1.5, 1.0e-9))?;

    printLn("  [PASS] tabular.series: NaN-aware stats, tie-avg rank, Spearman corr, rolling & EMA");
    Ok(())
}

def testUnifiedFrameConcept(): Result Void String = {
    let db = openMemory()?;
    let conn = connect(db)?;
    exec(conn, "CREATE TABLE trades (sym VARCHAR, price DOUBLE, qty DOUBLE)")?;
    exec(conn, "INSERT INTO trades VALUES ('BTC', 100.0, 5.0), ('BTC', 120.0, 10.0), ('ETH', 50.0, 20.0), ('SOL', 10.0, NULL)")?;
    let inPq = "/tmp/geisha_tabular_trades_in.parquet";
    let outPq = "/tmp/geisha_tabular_trades_out.parquet";
    writeParquet(conn, "SELECT * FROM trades", inPq)?;
    disconnect(conn);
    closeDb(db);

    // 1. Unified prefix-free verbs on LazyFrame
    let lf = scanParquet(inPq)
        |> dropNulls(["qty"])
        |> withColumns([alias(mul(col("price"), col("qty")), "notional")])
        |> filter(gt(col("notional"), litFloat(400.0)))
        |> groupByAgg(["sym"], [
            alias(sum(col("notional")), "total_notional"),
            alias(mean(col("price")), "avg_price"),
            alias(countAll(), "n_trades")
        ])
        |> sortDesc("total_notional")
        |> limit(10);

    let df = collect(lf)?;
    assertTrue("df shape (2, 4)", dfHeight(df) == 2 && dfWidth(df) == 4)?;

    let syms = dfColStr(df, "sym")?;
    let totals = dfSeries(df, "total_notional")?;
    let avgs = dfSeries(df, "avg_price")?;
    assertTrue("top sym == BTC", arrayGet(syms, 0) == "BTC")?;
    assertTrue("BTC total_notional == 1700", approxEq(seriesGet(totals, 0), 1700.0, 1.0e-6))?;
    assertTrue("BTC avg_price == 110", approxEq(seriesGet(avgs, 0), 110.0, 1.0e-6))?;
    assertTrue("second sym == ETH", arrayGet(syms, 1) == "ETH")?;

    // 2. Exact same prefix-free verbs (`sortAsc`, `selectCols`, `head`, `filter`) on eager DataFrame!
    let topEth = df
        |> sortAsc("total_notional")
        |> selectCols(["sym", "total_notional"])
        |> head(1);
    assertTrue("DataFrame via Frame concept shape (1, 2)", dfHeight(topEth) == 1 && dfWidth(topEth) == 2)?;
    let ethSyms = dfColStr(topEth, "sym")?;
    assertTrue("DataFrame sortAsc + head(1) == ETH", arrayGet(ethSyms, 0) == "ETH")?;

    let filteredDf = df |> filter(gt(col("total_notional"), litFloat(1200.0)));
    assertTrue("DataFrame filter rows == 1", dfHeight(filteredDf) == 1)?;

    let dropped = dfDrop(topEth, ["total_notional"]);
    assertTrue("dfDrop width == 1", dfWidth(dropped) == 1)?;
    assertTrue("dfFormat non-empty", strLen(dfFormat(topEth, 5)) > 20)?;

    // 3. Streaming sinkParquet + readParquet round-trip
    sinkParquet(lf, outPq)?;
    let reloaded = readParquet(outPq)?;
    assertTrue("reloaded parquet shape (2, 4)", dfHeight(reloaded) == 2 && dfWidth(reloaded) == 4)?;

    let _ = removeFile(inPq);
    let _ = removeFile(outPq);
    printLn("  [PASS] concept Frame: unified prefix-free API works identically on LazyFrame & DataFrame");
    Ok(())
}

def main(): Void = {
    printLn("Running tabular.gsa test suite...");
    match testSeriesStats() {
        Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
        Ok(_) ->
            match testUnifiedFrameConcept() {
                Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
                Ok(_) -> printLn("tabular.gsa: all tests passed!"),
            },
    }
}
